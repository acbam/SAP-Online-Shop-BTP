<mvc:View
    controllerName="onlinestore.controller.Cart"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Shopping Cart">
        <content>
            <List id="cartList" items="{cartModel>/cartItems}">
                <ObjectListItem
                    title="{cartModel>name}"
                    number="{cartModel>price}"
                    numberUnit="USD"
                    intro="{cartModel>category}"
                    icon="{cartModel>image}">
                    <attributes>
                        <ObjectAttribute text="{cartModel>description}" />
                    </attributes>
                    <!-- Кнопка удаления товара -->

                </ObjectListItem>
            </List>

            <VBox class="sapUiSmallMargin">
                <Label text="Total:" />
                <Text text="{cartModel>/totalPrice}" />
            </VBox>

            <Button text="Proceed to Checkout" press="onCheckoutPress"/>
        </content>
    </Page>

</mvc:View>