<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:f="sap.f" controllerName="onlinestore.controller.Main">
    <VBox class="mainPage">
        <Title text="Product categories" class="sapUiMediumMarginTop productTitle" />
        <Text text="Explore the world of Cambium innovation and witness the transformative power of wireless connectivity for a connected future." 
            class="sapUiSmallMarginTop sapUiMediumMarginBottom productSubtitle"/>
        <FlexBox
            width="100%"
            wrap="Wrap"
            alignItems="Start"
            justifyContent="SpaceBetween"
            items="{/Categories}">
            <items>
                <VBox width="17%" class="productCard">
                    <customData>
                        <core:CustomData key="id" value="{ID}" />
                    </customData>
                    <Image src="{image}" width="100%" height="150px" class="productImage"/>
                    <Text text="{name}" class="productName" />
                </VBox>
            </items>
        </FlexBox>
