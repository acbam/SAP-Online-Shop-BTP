<mvc:View
    controllerName="onlinestore.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <App>
        <Page title="Online Store" showNavButton="true" navButtonPress="onNavBack">
            <headerContent>
                <Toolbar class="menu">
                	<SearchField />
                    <Button icon="sap-icon://home" text="Home" class="menuButton" press="onNavToMain"/>
                    <Button icon="sap-icon://detail-more" text="About" class="menuButton" press="onNavToMac"/>
                    <Button icon="sap-icon://customer" class="" press="onLoginPress" />
                    <Button icon="sap-icon://cart" class="" press=".onNavToCart"/>
                </Toolbar>
            </headerContent>
            
            <content>
                <mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="sap.ui.demo.controller.App" class="container">
                    <App id="app"/>
                </mvc:View>
            </content>

             <!-- Диалоговое окно входа -->
            <Dialog id="loginDialog" title="Login">
                <VBox class="sapUiSmallMargin">
                    <Label text="Username"/>
                    <Input id="username" placeholder="Enter your username"/>
                    <Label text="Password"/>
                    <Input id="password" type="Password" placeholder="Enter your password"/>
                </VBox>
                <beginButton>
                    <Button text="Login" press="onLoginSubmit"/>
                </beginButton>
                <endButton>
                    <Button text="Cancel" press="onLoginCancel"/>
                </endButton>
            </Dialog>

        </Page>
    </App>
</mvc:View>